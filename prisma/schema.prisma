generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String               @id @default(uuid())
  email                          String               @unique
  passwordHash                   String?
  nombre                         String
  rol                            UserRole             @default(CLIENTE)
  telefono                       String?
  direccion                      String?
  dni                            String?
  especialidad                   String?
  matricula                      String?
  experiencia                    Int?
  picture                        String?
  activo                         Boolean              @default(true)
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  deletedAt                      DateTime?
  documents                      Document[]
  messages                       Message[]
  cases                          Order[]              @relation("LawyerCases")
  orders                         Order[]              @relation("ClientOrders")
  payouts                        LawyerPayout[]       @relation("LawyerPayouts")
  orderAssignmentLogsAsOldLawyer OrderAssignmentLog[] @relation("AssignmentFromOldLawyer")
  orderAssignmentLogsAsNewLawyer OrderAssignmentLog[] @relation("AssignmentToNewLawyer")
  reassignedOrderLogs            OrderAssignmentLog[] @relation("ReassignedByAdmin")
  pushSubscriptions              PushSubscription[]   @relation("UserPushSubscriptions")

  @@index([activo, createdAt(sort: Desc)])
  @@index([rol])
}

model Service {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  precio      Decimal  @db.Decimal(10, 2)
  imagenUrl   String?
  activo      Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
}

model Order {
  id                    String               @id @default(uuid())
  numericId             Int                  @unique @default(autoincrement())
  userId                String
  lawyerId              String?
  serviceId             Int
  paymentMethodId       String?
  total                 Decimal              @db.Decimal(10, 2)
  status                OrderStatus          @default(PENDIENTE)
  paymentId             String?
  activo                Boolean              @default(true)
  commissionAmount      Decimal?             @db.Decimal(10, 2)
  operationalCostAmount Decimal?             @db.Decimal(10, 2)
  platformFeeAmount     Decimal?             @db.Decimal(10, 2)
  taxAmount             Decimal?             @db.Decimal(10, 2)
  netProfitAmount       Decimal?             @db.Decimal(10, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedAt            DateTime?
  closedAt              DateTime?
  deletedAt             DateTime?
  reassignedAt          DateTime?
  documents             Document[]
  messages              Message[]
  assignmentLogs        OrderAssignmentLog[]
  lawyer                User?                @relation("LawyerCases", fields: [lawyerId], references: [id], onDelete: SetNull)
  paymentMethod         PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  service               Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  user                  User                 @relation("ClientOrders", fields: [userId], references: [id], onDelete: Restrict)
  payoutId              String?
  payout                LawyerPayout?        @relation("OrderToPayout", fields: [payoutId], references: [id], onDelete: SetNull)
  review                Review?

  @@index([lawyerId, status])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([paymentId])
  @@index([status, createdAt(sort: Desc)])
}

model PaymentMethod {
  id         String   @id @default(uuid())
  name       String
  identifier String   @unique
  isActive   Boolean  @default(true)
  icon       String?
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model FinancialSettings {
  id                           String   @id @default(uuid())
  lawyer_commission_percentage Decimal  @default(70) @db.Decimal(5, 2)
  operational_costs_percentage Decimal  @default(10) @db.Decimal(5, 2)
  tax_percentage               Decimal  @default(15) @db.Decimal(5, 2)
  platform_fee_percentage      Decimal  @default(5) @db.Decimal(5, 2)
  simulation_base              Decimal  @default(0) @db.Decimal(10, 2)
  whatsappPhone                String?  @map("whatsapp_phone")
  updated_at                   DateTime @updatedAt
  updated_by                   String?

  @@map("FinancialSettings")
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  senderId  String
  content   String
  isSystem  Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Asc)])
  @@index([senderId])
}

model Document {
  id         String   @id @default(uuid())
  orderId    String
  uploaderId String
  name       String
  url        String
  type       String
  size       Int
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([uploaderId])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderAssignmentLog {
  id           String   @id @default(uuid())
  orderId      String
  fromLawyerId String?
  toLawyerId   String
  reassignedBy String
  reason       String?
  createdAt    DateTime @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromLawyer User? @relation("AssignmentFromOldLawyer", fields: [fromLawyerId], references: [id], onDelete: SetNull)
  toLawyer   User  @relation("AssignmentToNewLawyer", fields: [toLawyerId], references: [id], onDelete: Restrict)
  reassigner User  @relation("ReassignedByAdmin", fields: [reassignedBy], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([fromLawyerId])
  @@index([toLawyerId])
}

enum UserRole {
  CLIENTE
  ABOGADO
  ADMIN
}

enum OrderStatus {
  PAGO_PENDIENTE
  PAID
  PAGO_RECHAZADO
  PENDIENTE
  EN_PROGRESO
  REVISION
  COMPLETADO
  CANCELADO
  FALLIDO
}

enum PayoutStatus {
  PENDIENTE
  COMPLETADO
  RECHAZADO
}

model LawyerPayout {
  id        String       @id @default(uuid())
  lawyerId  String
  amount    Decimal      @db.Decimal(10, 2)
  status    PayoutStatus @default(PENDIENTE)
  method    String? // e.g. Transferencia, PayPal
  reference String? // ID de comprobante bancario
  notes     String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  lawyer User    @relation("LawyerPayouts", fields: [lawyerId], references: [id], onDelete: Restrict)
  orders Order[] @relation("OrderToPayout")

  @@map("LawyerPayouts")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model EventLog {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("pending")
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  error       String?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("EventLog")
}
