generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  nombre       String
  rol          UserRole   @default(CLIENTE)
  telefono     String?
  direccion    String?
  dni          String?
  especialidad String?
  matricula    String?
  experiencia  Int?
  picture      String?
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]
  messages     Message[]
  cases        Order[]    @relation("LawyerCases")
  orders       Order[]    @relation("ClientOrders")
}

model Service {
  id          Int     @id @default(autoincrement())
  titulo      String
  descripcion String
  precio      Decimal @db.Decimal(10, 2)
  imagenUrl   String?
  activo      Boolean @default(true)
  orders      Order[]
}

model Order {
  id                    String         @id @default(uuid())
  numericId             Int            @unique @default(autoincrement())
  userId                String
  lawyerId              String?
  serviceId             Int
  paymentMethodId       String?
  total                 Decimal        @db.Decimal(10, 2)
  status                OrderStatus    @default(PENDIENTE)
  paymentId             String?
  activo                Boolean        @default(true)
  commissionAmount      Decimal?       @db.Decimal(10, 2)
  operationalCostAmount Decimal?       @db.Decimal(10, 2)
  platformFeeAmount     Decimal?       @db.Decimal(10, 2)
  taxAmount             Decimal?       @db.Decimal(10, 2)
  netProfitAmount       Decimal?       @db.Decimal(10, 2)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  assignedAt            DateTime?
  closedAt              DateTime?
  documents             Document[]
  messages              Message[]
  lawyer                User?          @relation("LawyerCases", fields: [lawyerId], references: [id])
  paymentMethod         PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  service               Service        @relation(fields: [serviceId], references: [id])
  user                  User           @relation("ClientOrders", fields: [userId], references: [id])
  review                Review?

  @@index([lawyerId, status])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([serviceId])
  @@index([status, createdAt(sort: Desc)])
}

model PaymentMethod {
  id         String   @id @default(uuid())
  name       String
  identifier String   @unique
  isActive   Boolean  @default(true)
  icon       String?
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model FinancialSettings {
  id                           String   @id @default(uuid())
  lawyer_commission_percentage Decimal  @default(70) @db.Decimal(5, 2)
  operational_costs_percentage Decimal  @default(10) @db.Decimal(5, 2)
  tax_percentage               Decimal  @default(15) @db.Decimal(5, 2)
  platform_fee_percentage      Decimal  @default(5) @db.Decimal(5, 2)
  whatsappPhone                String?  @map("whatsapp_phone")
  updated_at                   DateTime @updatedAt
  updated_by                   String?

  @@map("FinancialSettings")
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  senderId  String
  content   String
  isSystem  Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([orderId, createdAt(sort: Asc)])
  @@index([senderId])
}

model Document {
  id         String   @id @default(uuid())
  orderId    String
  uploaderId String
  name       String
  url        String
  type       String
  size       Int
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
  uploader   User     @relation(fields: [uploaderId], references: [id])

  @@index([orderId])
  @@index([uploaderId])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

enum UserRole {
  CLIENTE
  ABOGADO
  ADMIN
}

enum OrderStatus {
  PAGO_PENDIENTE
  PAID
  PAGO_RECHAZADO
  PENDIENTE
  EN_PROGRESO
  REVISION
  COMPLETADO
  CANCELADO
  FALLIDO
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
